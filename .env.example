# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_OWNER_CHAT_ID=123456789
# Optional but recommended: shared secret Telegram sends back on every webhook
# call (set automatically by scripts/set_webhook.py).
TELEGRAM_WEBHOOK_SECRET=change-me

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-...
# Strong model, used ONLY for product content generation (LLM call #1 in Module 2)
GENERATION_MODEL=anthropic/claude-sonnet-4-6
# Cheap model, used everywhere else (scanning, scoring, listing copy)
ROUTINE_MODEL=deepseek/deepseek-chat

# --- Gumroad ---
GUMROAD_ACCESS_TOKEN=your-gumroad-access-token
