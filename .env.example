# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Telegram ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_OWNER_CHAT_ID=123456789
# Optional but recommended: shared secret Telegram sends back on every webhook
# call (set automatically by scripts/set_webhook.py).
TELEGRAM_WEBHOOK_SECRET=change-me

# --- LLM (OpenRouter) ---
OPENROUTER_API_KEY=sk-or-...
# Strong model, used ONLY for product content generation (LLM call #1 in Module 2)
GENERATION_MODEL=anthropic/claude-sonnet-4-6
# Cheap model, used everywhere else (scanning, scoring, listing copy)
ROUTINE_MODEL=deepseek/deepseek-chat

# --- Gumroad ---
GUMROAD_ACCESS_TOKEN=your-gumroad-access-token
# Upload strategy: "api" (Strategy A) or "playwright" (Strategy B) — decide by
# running spike/gumroad_create_spike.py with a real token.
UPLOAD_STRATEGY=api
# Required only for UPLOAD_STRATEGY=playwright:
# GUMROAD_EMAIL=you@example.com
# GUMROAD_PASSWORD=...

# --- Niches (parallel product lines; keys from app/config.py NICHES) ---
TRENDMILL_NICHES=spreadsheets,trader_tools,seller_tools
# Optional: extra niches proposed by the weekly niche scout — paste its JSON here.
# TRENDMILL_EXTRA_NICHES={"key": {"label": "...", "seeds": [...], "relevance_terms": [...]}}
